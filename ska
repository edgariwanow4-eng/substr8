import board
import adafruit_dht
import math
from kivy.app import App
from kivy.clock import Clock
from kivy.uix.label import Label
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.floatlayout import FloatLayout
from kivy.uix.image import Image
from kivy.uix.widget import Widget
from kivy.core.window import Window
from kivy.graphics import Color, Line, StencilPush, StencilUse, StencilUnUse, StencilPop, Rectangle

# Fullscreen
Window.fullscreen = 'auto'

# Sensor on GPIO17
dht_device = adafruit_dht.DHT22(board.D17)

class PulseGraph(Widget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.points = []
        self.max_points = 100
        self.step = 0
        self.neon_green = (0.2, 1, 0.2, 1)
        
        # Odswiezanie grafiki przy zmianie pozycji lub rozmiaru
        self.bind(pos=self.update_canvas, size=self.update_canvas)
        Clock.schedule_interval(self.update_pulse, 0.05)

    def update_pulse(self, dt):
        self.step += 0.3
        # Bazowa wysokosc Y wzgledem pozycji widgetu
        base_y = self.y + (self.height / 2)
        
        # Symulacja bicia serca
        if 0.5 < (self.step % 6) < 0.8:
            y_val = base_y + (math.sin(self.step * 10) * self.height * 0.4)
        else:
            y_val = base_y + (math.sin(self.step) * 5)

        self.points.append(y_val)

        if len(self.points) > self.max_points:
            self.points.pop(0)

        self.update_canvas()

    def update_canvas(self, *args):
        self.canvas.clear()
        with self.canvas:
            # Maskowanie - zapobiega rysowaniu poza obszarem widgetu
            StencilPush()
            Rectangle(pos=self.pos, size=self.size)
            StencilUse()
            
            Color(*self.neon_green)
            if len(self.points) > 1:
                final_points = []
                x_increment = self.width / (self.max_points - 1)
                for i, y_val in enumerate(self.points):
                    final_points.append(self.x + i * x_increment)
                    final_points.append(y_val)
                
                Line(points=final_points, width=1.5)
            
            StencilUnUse()
            StencilPop()

class DHTApp(App):
    def build(self):
        # Glowny uklad poziomy
        self.main_layout = BoxLayout(orientation="horizontal")

        # --- LEWA STRONA: ZDJECIE (size_hint 0.33 - 1/3 ekranu) ---
        self.left_side = FloatLayout(size_hint=(0.333, 1))
        
        self.bg_image = Image(
            source='abc.png', 
            allow_stretch=True, 
            keep_ratio=False,
            size_hint=(1, 1),
            pos_hint={'x': 0, 'y': 0}
        )
        self.left_side.add_widget(self.bg_image)

        # Kolory
        neon_green = (0.2, 1, 0.2, 1)
        blue_color = (0.2, 0.5, 1, 1)

        # Etykiety temperatury na obrazku
        self.temp_blue = Label(text="-- C", font_size='25sp', color=blue_color, pos_hint={'x': -0.35, 'y': 0.4})
        self.temp_lt = Label(text="-- C", font_size='25sp', color=neon_green, pos_hint={'x': -0.15, 'y': 0.25})
        self.temp_rt = Label(text="-- C", font_size='25sp', color=neon_green, pos_hint={'x': 0.15, 'y': 0.25})
        self.temp_lb = Label(text="-- C", font_size='25sp', color=neon_green, pos_hint={'x': -0.15, 'y': -0.2})
        self.temp_rb = Label(text="-- C", font_size='25sp', color=neon_green, pos_hint={'x': 0.15, 'y': -0.2})

        self.hum_center = Label(
            text="-- %", 
            font_size='50sp', 
            bold=True,
            color=neon_green,
            pos_hint={'center_x': 0.5, 'center_y': 0.55}
        )

        self.left_side.add_widget(self.temp_blue)
        self.left_side.add_widget(self.temp_lt)
        self.left_side.add_widget(self.temp_rt)
        self.left_side.add_widget(self.temp_lb)
        self.left_side.add_widget(self.temp_rb)
        self.left_side.add_widget(self.hum_center)
        
        # --- PRAWA STRONA: PULS I STATUS (size_hint 0.667 - reszta ekranu) ---
        self.right_panel = BoxLayout(orientation="vertical", size_hint=(0.667, 1))

        # Gora: Wykres pulsu
        self.pulse_container = FloatLayout(size_hint=(1, 0.5))
        self.pulse_graph = PulseGraph(size_hint=(1, 1))
        self.pulse_label = Label(
            text="HEART RATE SIMULATION", 
            font_size='14sp', 
            color=neon_green,
            pos_hint={'center_x': 0.5, 'y': 0.4}
        )
        self.pulse_container.add_widget(self.pulse_graph)
        self.pulse_container.add_widget(self.pulse_label)

        # Dol: Panel statusu
        self.status_panel = BoxLayout(
            orientation="vertical", 
            padding=20, 
            spacing=10,
            size_hint=(1, 0.5)
        )

        self.status_label = Label(
            text="Initializing...", 
            font_size='18sp',
            color=(0.7, 0.7, 0.7, 1)
        )

        self.status_panel.add_widget(Label(text="SYSTEM STATUS", font_size='20sp', bold=True))
        self.status_panel.add_widget(self.status_label)

        self.right_panel.add_widget(self.pulse_container)
        self.right_panel.add_widget(self.status_panel)

        self.main_layout.add_widget(self.left_side)
        self.main_layout.add_widget(self.right_panel)

        Clock.schedule_interval(self.update_data, 2)

        return self.main_layout

    def update_data(self, dt):
        try:
            temperature = dht_device.temperature
            humidity = dht_device.humidity

            if temperature is not None and humidity is not None:
                val_temp = "{:.1f} C".format(temperature)
                val_hum = "{:.1f} %".format(humidity)
                
                self.temp_blue.text = val_temp
                self.temp_lt.text = val_temp
                self.temp_rt.text = val_temp
                self.temp_lb.text = val_temp
                self.temp_rb.text = val_temp
                self.hum_center.text = val_hum
                
                self.status_label.text = "Status: OK"
                self.status_label.color = (0, 1, 0, 1)

        except RuntimeError:
            self.status_label.text = "Read error..."
            self.status_label.color = (1, 0.5, 0, 1)
            
        except Exception as e:
            self.status_label.text = "Error: " + str(e)
            self.status_label.color = (1, 0, 0, 1)

    def on_stop(self):
        dht_device.exit()

if __name__ == "__main__":
    DHTApp().run()
